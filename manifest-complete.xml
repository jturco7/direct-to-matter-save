<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">

  <Id>60f294c5-c78a-4e2e-8fd2-87cd853157cd</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>John T. Turco Associates</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Direct-to-Matter Save"/>
  <Description DefaultValue="Save email attachments directly to a Centerbase matter in SharePoint"/>
  <IconUrl DefaultValue="https://jturco7.github.io/direct-to-matter-save/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://jturco7.github.io/direct-to-matter-save/icon-80.png"/>
  <SupportUrl DefaultValue="https://jturco7.github.io/direct-to-matter-save/"/>

  <AppDomains>
    <AppDomain>https://jturco7.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://jturco7.github.io/direct-to-matter-save/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <DesktopFormFactor>

          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>

      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://jturco7.github.io/direct-to-matter-save/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://jturco7.github.io/direct-to-matter-save/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://jturco7.github.io/direct-to-matter-save/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://jturco7.github.io/direct-to-matter-save/taskpane.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://jturco7.github.io/direct-to-matter-save/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Turco Law"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Save to Matter"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Save email attachments directly to a Centerbase matter in SharePoint"/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
