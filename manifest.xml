    <!--   <Id>YOUR-AZURE-AD-APP-CLIENT-ID-HERE</Id>                       -->
    <!--   <Resource>api://jturco7.github.io/YOUR-AZURE-AD-APP-CLIENT-ID</Resource> -->
    <!--   <Scopes>                                                        -->
    <!--     <Scope>User.Read</Scope>                                      -->
    <!--     <Scope>Files.ReadWrite.All</Scope>                            -->
    <!--     <Scope>Sites.ReadWrite.All</Scope>                            -->
    <!--     <Scope>profile</Scope>                                        -->
    <!--     <Scope>openid</Scope>                                         -->
    <!--   </Scopes>                                                       -->
    <!-- </WebApplicationInfo>                                             -->

  </VersionOverrides>
</OfficeApp>
