    <!--   3. Authorize Office client IDs (d3590ed6-52b3-4102-aeff-aad...) -->
    <!--   4. Wire Office.auth.getAccessToken() in taskpane.js             -->
    <!--   5. Implement on-behalf-of flow on a backend (or use sp-bridge)  -->
